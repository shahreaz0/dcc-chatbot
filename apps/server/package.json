		"@openrouter/ai-sdk-provider": "^3.0.0",
		"@scalar/hono-api-reference": "^0.9.48",
		"ai": "catalog:",
		"dotenv": "catalog:",
		"evlog": "catalog:",
		"hono": "^4.12.27",
		"jose": "^6.0.0",
		"stoker": "^2.0.1",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@dcc-chatbot/config": "workspace:*",
		"@types/bun": "catalog:",
		"tsdown": "^0.22.3",
		"typescript": "catalog:"
	}
}
